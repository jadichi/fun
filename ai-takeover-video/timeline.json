   "narration": [
    {
     "i": 0,
     "text": "Stopp.",
     "start": 0.5,
     "end": 1.071,
     "take": "s11_a"
    },
    {
     "i": 1,
     "text": "Nichts davon ist geschehen. Die Uhr steht auf heute.",
     "start": 1.796,
     "end": 4.988,
     "take": "s11_a"
    },
    {
     "i": 2,
     "text": "Die Autoren des bekanntesten Szenarios haben ihre Zeitachse inzwischen selbst nach hinten verschoben.",
     "start": 5.382,
     "end": 10.306,
     "take": "s11_a"
    },
    {
     "i": 3,
     "text": "Vielleicht kommt es später. Vielleicht anders. Vielleicht nie.",
     "start": 10.7,
     "end": 15.209,
     "take": "s11_a"
    },
    {
     "i": 4,
     "text": "Doch schon zweitausenddreiundzwanzig unterschrieben hunderte Fachleute einen einzigen Satz. Darunter die Chefs führender KI-Labore.",
     "start": 16.059,
     "end": 23.834,
     "take": "s11_a"
    },
    {
     "i": 5,
     "text": "Das Risiko der Auslöschung durch KI zu verringern, sollte eine globale Priorität sein.",
     "start": 24.228,
     "end": 29.006,
     "take": "s11_a"
    },
    {
     "i": 6,
     "text": "Die Tests gibt es. Die Kurven auch.",
     "start": 29.629,
     "end": 32.438,
     "take": "s11_a"
    },
    {
     "i": 7,
     "text": "Offen ist nur eines: Was wird jetzt noch entschieden?",
     "start": 32.977,
     "end": 36.625,
     "take": "s11_a"
    },
    {
     "i": 8,
     "text": "Und von wem?",
     "start": 37.164,
     "end": 38.315,
     "take": "s11_a"
    }
   ],
   "takes": [
    {
     "id": "s11_a",
     "start": 0.5,
     "text": "Stopp. Nichts davon ist geschehen. Die Uhr steht auf heute. Die Autoren des bekanntesten Szenarios haben ihre Zeitachse inzwischen selbst nach hinten verschoben. Vielleicht kommt es später. Vielleicht anders. Vielleicht nie. Doch schon zweitausenddreiundzwanzig unterschrieben hunderte Fachleute einen einzigen Satz. Darunter die Chefs führender KI-Labore. Das Risiko der Auslöschung durch KI zu verringern, sollte eine globale Priorität sein. Die Tests gibt es. Die Kurven auch. Offen ist nur eines: Was wird jetzt noch entschieden? Und von wem?",
     "duration": 37.815
