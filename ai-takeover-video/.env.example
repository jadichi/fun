# Kopiere diese Datei nach .env und trage den Schlüssel ein. .env wird nicht eingecheckt.
ELEVENLABS_API_KEY=
# Ohne Schlüssel nutzt `npm run final` die Takes, die schon in tts/ liegen.
# Optional: andere Stimme (IDs zeigt `node tts/generate.js --list-voices`), Modell und Sprechtempo
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SPEED=1.0
